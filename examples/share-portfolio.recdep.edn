{:recdep/version 2,
 :grids
 {"$" {:rows 12, :cols 3, :col-widths {0 150, 1 200, 2 760},
       :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}
                 {:area "A1", :style {:font-weight 700, :font-size "16px"}}
                 {:area "B2:B4", :format "[$£]#,##0.00"} {:area "B5", :format "d mmm yyyy hh:mm"}]},

  ;; holdings
  "B6" {:rows 6, :cols 3, :col-widths {0 150, 1 900, 2 380},
        :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}]},

  "B6>B2" {:header-texts ["symbol" "shares" "invested" "price" "previous" "value" "gain" "today" "weight"], :rows 5, :cols 9,
           :generated true, :headers true, :col-widths {0 70, 1 70, 2 100, 3 90, 4 90, 5 100, 6 100, 7 90, 8 70},
           :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column "shares", :format "#,##0"} {:column ["invested" "price" "previous"], :format "$#,##0.00"}
                     {:column ["value" "gain" "today"], :format "[$£]#,##0.00"} {:column "weight", :format "0.0%"}]},

  ;; trades
  "B7" {:rows 4, :cols 3, :col-widths {0 150, 1 640, 2 380},
        :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}]},
  "B7>B2" {:rows 10, :cols 6, :headers true, :col-widths {0 110, 1 80, 2 70, 3 70, 4 90, 5 70},
           :formats [{:area "B2:Bde", :render "(opens \"$>share>ticker\")"} {:area "A2:Ade", :format "d mmm yyyy"} {:area "C2:Cde", :kind :one-of, :of ["buy" "sell"]}
                     {:area "E2:Fde", :format "$#,##0.00"}]},

  ;; prices
  "B8" {:rows 9, :cols 3, :col-widths {0 150, 1 640, 2 380},
        :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}
                  {:area "B3", :format "ddd d mmm hh:mm"} {:area "B8", :format "d mmm yyyy hh:mm"} {:area "B9", :format "0.0000"}]},

  "B8>B4" {:header-texts ["symbol" "price" "previous" "as-of"], :rows 5, :cols 4, :generated true, :headers true,
           :col-widths {0 70, 1 90, 2 90, 3 110}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column ["price" "previous"], :format "$#,##0.00"} {:column "as-of", :format "d mmm hh:mm"}]},
  "B8>B5" {:header-texts ["symbol" "price" "previous" "as-of"], :rows 5, :cols 4, :generated true, :headers true,
           :col-widths {0 70, 1 90, 2 90, 3 110}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column ["price" "previous"], :format "$#,##0.00"} {:column "as-of", :format "d mmm hh:mm"}]},
  "B8>B6" {:header-texts ["symbol" "price" "previous" "as-of"], :rows 5, :cols 4, :generated true, :headers true,
           :col-widths {0 70, 1 90, 2 90, 3 110}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column ["price" "previous"], :format "$#,##0.00"} {:column "as-of", :format "d mmm hh:mm"}]},
  "B8>B7" {:header-texts ["symbol" "price" "previous" "as-of"], :rows 5, :cols 4, :generated true, :headers true,
           :col-widths {0 70, 1 90, 2 90, 3 110}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column ["price" "previous"], :format "$#,##0.00"} {:column "as-of", :format "d mmm hh:mm"}]},

  ;; performance
  "B9" {:rows 5, :cols 3, :col-widths {0 150, 1 760, 2 380}, :row-heights {2 340, 3 150, 4 150},
        :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}]},

  "B9>B4" {:header-texts ["symbol" "date" "open" "high" "low" "close"], :rows 361, :cols 6, :generated true, :headers true, :freeze {:rows 1},
           :col-widths {0 70, 1 110, 2 90, 3 90, 4 90, 5 90}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column "date", :format "d mmm yyyy"} {:column ["open" "high" "low" "close"], :format "$#,##0.00"}]},
  "B9>B5" {:header-texts ["symbol" "date" "open" "high" "low" "close"], :rows 361, :cols 6, :generated true, :headers true, :freeze {:rows 1},
           :col-widths {0 70, 1 110, 2 90, 3 90, 4 90, 5 90}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column "date", :format "d mmm yyyy"} {:column ["open" "high" "low" "close"], :format "$#,##0.00"}]},
  "B9>B2" {:header-texts ["date" "symbol" "open" "high" "low" "close"], :rows 361, :cols 6, :generated true, :headers true, :freeze {:rows 1},
           :col-widths {0 110, 1 70, 2 90, 3 90, 4 90, 5 90}, :formats [{:column "symbol", :render "(opens \"$>share>ticker\")"} {:column "date", :format "d mmm yyyy"} {:column ["open" "high" "low" "close"], :format "$#,##0.00"}]},

  ;; share: one share up close
  "B11" {:rows 7, :cols 3, :col-widths {0 150, 1 760, 2 380}, :row-heights {2 150, 5 330, 6 560},
         :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}
                   {:area "B4", :format "$#,##0.00"} {:area "B5", :format "0.00%"}]},

  ;; settings
  "B10" {:rows 8, :cols 3, :col-widths {0 150, 1 380, 2 560},
         :formats [{:area "A:A", :style {:font-weight 600}} {:area "C:C", :render "note", :style {:color "var(--muted)"}}
                   {:area "B2", :kind :one-of, :of ["Finnhub" "Twelve Data" "Yahoo through a relay"], :refuse true}]}},

 :cells
 {"A1" {:src "\"Share portfolio\""},
  "C1" {:src "\"Shares bought and sold, valued at live prices in pounds. The prices come from a web service you choose in [[$>settings>A1|Settings]] (Finnhub, Twelve Data, or Yahoo through a relay of your own), every quarter hour while New York's market is open; GBP/USD from Frankfurter, every hour. Until you give the service's free key in [[$>settings>A1|Settings]], it shows the prices recorded when the example was built, dimmed.\""},
  "A2" {:src "\"Value\""}, "B2" {:name "total-value", :src "(SUM $>holdings>positions>value)"},
  "C2" {:src "\"What the shares are worth now, in pounds.\""},
  "A3" {:src "\"Today\""}, "B3" {:name "total-today", :src "(SUM $>holdings>positions>today)"},
  "C3" {:src "\"How much that moved since the last close.\""},
  "A4" {:src "\"Gain\""}, "B4" {:name "total-gain", :src "(SUM $>holdings>positions>gain)"},
  "C4" {:src "\"Value less what was paid for the shares still held (net of sales and fees).\""},
  "A5" {:src "\"Prices of\""}, "B5" {:src "$>prices>as-of"},
  "C5" {:src "\"When the prices shown are from.\""},
  "A6" {:src "\"Holdings\""}, "B6" {:name "holdings"},
  "C6" {:src "\"[[$>holdings>A1|Each share held]]: how many, what was paid, its price, value, gain and weight.\""},
  "A7" {:src "\"Trades\""}, "B7" {:name "trades"},
  "C7" {:src "\"[[$>trades>A1|Every purchase and sale]]: type a new one in the empty row.\""},
  "A8" {:src "\"Prices\""}, "B8" {:name "prices"},
  "C8" {:src "\"[[$>prices>A1|The prices and the exchange rate]], as the web services answer them.\""},
  "A9" {:src "\"Performance\""}, "B9" {:name "performance"},
  "C9" {:src "\"[[$>performance>A1|What the shares held now were worth]] over the last 90 trading days.\""},
  "A11" {:src "\"A share\""}, "B11" {:name "share"},
  "C11" {:src "\"[[$>share>A1|One share up close]]: the company, its price, its price history day by day, and its news.\""},
  "A10" {:src "\"Settings\""}, "B10" {:name "settings"},
  "C10" {:src "\"[[$>settings>A1|Where prices come from]] and their keys, how often, and in which currency.\""},

  ;; ---- holdings
  "B6>A1" {:src "\"Holdings\""},
  "B6>C1" {:src "\"Worked out from the trades and the prices. [[$>A1|Home]]\""},
  "B6>A2" {:src "\"Held\""},
  "B6>B2" {:name "positions", :render "(grid-view)",
           :src "(steps $>trades>log [{:op :compute :name \"held\" :expr #(if (= \"sell\" (:side %)) (- (:qty %)) (:qty %))} {:op :compute :name \"paid\" :expr #(if (= \"sell\" (:side %)) (- (:fees %) (* (:qty %) (:price %))) (+ (* (:qty %) (:price %)) (:fees %)))} {:op :group :by [:symbol] :aggs [{:fn :sum :column :held :as :shares} {:fn :sum :column :paid :as :invested}]} {:op :join :table $>prices>quotes :on [[:symbol :symbol]] :columns [:price :previous]} {:op :compute :name \"value\" :expr #(* (:shares %) (:price %) $>prices>usd-gbp)} {:op :compute :name \"gain\" :expr #(- (:value %) (* (:invested %) $>prices>usd-gbp))} {:op :compute :name \"today\" :expr #(* (:shares %) (- (:price %) (:previous %)) $>prices>usd-gbp)} {:op :window :fn :share :column :value :as :weight}])"},
  "B6>A3" {:src "\"Weights\""},
  "B6>B3" {:src "positions", :render "(chart :donut :symbol :value)"},

  ;; ---- trades
  "B7>A1" {:src "\"Trades\""},
  "B7>C1" {:src "\"Every purchase and sale, in dollars. Type a new one in the empty row below: the holdings follow. [[$>A1|Home]]\""},
  "B7>A2" {:src "\"Trades\""},
  "B7>B2" {:name "log", :render "(grid-view)"},
  "B7>B2>A1" {:src "\"date\""}, "B7>B2>B1" {:src "\"symbol\""}, "B7>B2>C1" {:src "\"side\""},
  "B7>B2>D1" {:src "\"qty\""}, "B7>B2>E1" {:src "\"price\""}, "B7>B2>F1" {:src "\"fees\""},
  "B7>B2>A2" {:src "2024-02-12"}, "B7>B2>B2" {:src "\"AAPL\""}, "B7>B2>C2" {:src "\"buy\""}, "B7>B2>D2" {:src "40"}, "B7>B2>E2" {:src "187.15"}, "B7>B2>F2" {:src "4.95"},
  "B7>B2>A3" {:src "2024-02-12"}, "B7>B2>B3" {:src "\"MSFT\""}, "B7>B2>C3" {:src "\"buy\""}, "B7>B2>D3" {:src "15"}, "B7>B2>E3" {:src "415.26"}, "B7>B2>F3" {:src "4.95"},
  "B7>B2>A4" {:src "2024-05-20"}, "B7>B2>B4" {:src "\"KO\""}, "B7>B2>C4" {:src "\"buy\""}, "B7>B2>D4" {:src "120"}, "B7>B2>E4" {:src "63.10"}, "B7>B2>F4" {:src "4.95"},
  "B7>B2>A5" {:src "2024-09-03"}, "B7>B2>B5" {:src "\"JNJ\""}, "B7>B2>C5" {:src "\"buy\""}, "B7>B2>D5" {:src "50"}, "B7>B2>E5" {:src "162.30"}, "B7>B2>F5" {:src "4.95"},
  "B7>B2>A6" {:src "2025-01-15"}, "B7>B2>B6" {:src "\"AAPL\""}, "B7>B2>C6" {:src "\"buy\""}, "B7>B2>D6" {:src "20"}, "B7>B2>E6" {:src "237.87"}, "B7>B2>F6" {:src "4.95"},
  "B7>B2>A7" {:src "2025-04-08"}, "B7>B2>B7" {:src "\"MSFT\""}, "B7>B2>C7" {:src "\"buy\""}, "B7>B2>D7" {:src "10"}, "B7>B2>E7" {:src "354.56"}, "B7>B2>F7" {:src "4.95"},
  "B7>B2>A8" {:src "2025-06-30"}, "B7>B2>B8" {:src "\"KO\""}, "B7>B2>C8" {:src "\"sell\""}, "B7>B2>D8" {:src "40"}, "B7>B2>E8" {:src "71.60"}, "B7>B2>F8" {:src "4.95"},
  "B7>B2>A9" {:src "2025-10-01"}, "B7>B2>B9" {:src "\"JNJ\""}, "B7>B2>C9" {:src "\"buy\""}, "B7>B2>D9" {:src "25"}, "B7>B2>E9" {:src "187.50"}, "B7>B2>F9" {:src "4.95"},

  ;; ---- prices
  "B8>A1" {:src "\"Prices\""},
  "B8>C1" {:src "\"Each provider is one cell: its request, and its answer made into the same table (symbol, price, previous close, as of). Only the one chosen in Settings asks; the others are blank. Adding a provider is one more cell like them, and one more name in quotes. [[$>A1|Home]]\""},
  "B8>A2" {:src "\"Symbols\""}, "B8>B2" {:name "symbols", :render "table", :src "(UNIQUE (SORT $>trades>log>symbol))"},
  "B8>A3" {:src "\"Slot\""}, "B8>B3" {:name "slot", :src "(every $>settings>price-schedule {:zone $>settings>market-zone})"},
  "B8>C3" {:src "\"The latest slot of the schedule: the prices are asked again when the next comes.\""},
  "B8>A4" {:src "\"Finnhub\""},
  "B8>B4" {:name "finnhub", :render "(grid-view)",
           :src "(when (= $>settings>provider \"Finnhub\") (steps (web \"https://finnhub.io/api/v1/quote\" {:query {:symbol symbols :token (secret \"finnhub\")} :each :symbol :fresh slot}) [{:op :columns :keep [:symbol :c :pc :t] :rename {:c :price :pc :previous :t :as-of}} {:op :type :column :as-of :to :date :from :unix}]))"},
  "B8>C4" {:src "\"One request a share (Finnhub's free plan: 60 a minute, US shares). Its key, finnhub, is given in [[$>settings>A1|Settings]].\""},
  "B8>A5" {:src "\"Twelve Data\""},
  "B8>B5" {:name "twelvedata", :render "(grid-view)",
           :src "(when (= $>settings>provider \"Twelve Data\") (steps (web \"https://api.twelvedata.com/quote\" {:query {:symbol symbols :apikey (secret \"twelvedata\")} :fresh slot}) [{:op :unpivot :columns :all :name :symbol :value :quote} {:op :unnest :column :quote :keep [:close :previous_close :datetime]} {:op :columns :rename {:close :price :previous_close :previous :datetime :as-of}} {:op :type :column [:price :previous] :to :number} {:op :type :column :as-of :to :date}]))"},
  "B8>C5" {:src "\"One request for every share (Twelve Data's free plan: 8 shares a minute, 800 a day, US shares). Its key, twelvedata, is given in [[$>settings>A1|Settings]].\""},
  "B8>A6" {:src "\"Yahoo\""},
  "B8>B6" {:name "yahoo", :render "(grid-view)",
           :src "(when (= $>settings>provider \"Yahoo through a relay\") (steps (web (str $>settings>relay \"v7/finance/spark\") {:query {:symbols symbols :range \"1d\" :interval \"1d\"} :fresh slot}) [{:op :unnest :column :spark :path [:result]} {:op :unnest :column :response :path [0 :meta] :keep [:regularMarketPrice :chartPreviousClose :regularMarketTime]} {:op :columns :rename {:regularMarketPrice :price :chartPreviousClose :previous :regularMarketTime :as-of}} {:op :type :column :as-of :to :date :from :unix}]))"},
  "B8>C6" {:src "\"Yahoo, through your relay (Settings): no key, any market Yahoo has.\""},
  "B8>A7" {:src "\"Quotes\""}, "B8>B7" {:name "quotes", :render "(grid-view)", :src "(or finnhub twelvedata yahoo)"},
  "B8>C7" {:src "\"The chosen provider's table: what the holdings read.\""},
  "B8>A8" {:src "\"As of\""}, "B8>B8" {:name "as-of", :src "(MAX quotes>as-of)"},
  "B8>A9" {:src "\"USD in GBP\""},
  "B8>B9" {:name "usd-gbp", :src "(get-in (web \"https://api.frankfurter.dev/v1/latest\" {:query {:base \"USD\" :symbols $>settings>report-in} :fresh (every \"1h\")}) [:rates (keyword $>settings>report-in)])"},
  "B8>C9" {:src "\"The European Central Bank's rate, from Frankfurter (no key needed), asked every hour.\""},

  ;; ---- performance
  "B9>A1" {:src "\"Performance\""},
  "B9>C1" {:src "\"What the shares held now were worth each day, in pounds at today's rate: the daily closes, asked once a day after New York's close, from Twelve Data (Finnhub's free plan has no history), or from Yahoo when that is the provider. [[$>A1|Home]]\""},
  "B9>A2" {:src "\"Closes\""},
  "B9>B2" {:name "closes", :render "(grid-view 6 6)",
           :src "(if (= $>settings>provider \"Yahoo through a relay\") yahoo-closes td-closes)"},
  "B9>A4" {:src "\"From Twelve Data\""},
  "B9>B4" {:name "td-closes", :render "(grid-view 4 6)", :src "(when-not (= $>settings>provider \"Yahoo through a relay\") (steps (web \"https://api.twelvedata.com/time_series\" {:query {:symbol $>prices>symbols :interval \"1day\" :outputsize 90 :apikey (secret \"twelvedata\")} :fresh (every \"0 17 * * 1-5\" {:zone $>settings>market-zone})}) [{:op :unpivot :columns :all :name :symbol :value :series} {:op :unnest :column :series :path [:values]} {:op :columns :keep [:symbol :datetime :open :high :low :close] :rename {:datetime :date}} {:op :type :column :date :to :date} {:op :type :column [:open :high :low :close] :to :number}]))"},
  "B9>C4" {:src "\"Twelve Data's daily series for every share in one request, made a table by steps: a row per share (unpivot), a row per day (unnest its values), numbers and dates from text.\""},
  "B9>A5" {:src "\"From Yahoo\""},
  "B9>B5" {:name "yahoo-closes", :render "(grid-view 4 6)", :src "(when (= $>settings>provider \"Yahoo through a relay\") (steps (web (str $>settings>relay \"v8/finance/chart/{symbol}\") {:query {:symbol $>prices>symbols :range \"6mo\" :interval \"1d\"} :each :symbol :fresh (every \"0 17 * * 1-5\" {:zone $>settings>market-zone})}) [{:op :unnest :column :chart :path [:result 0]} {:op :unnest :column :indicators :path [:quote 0]} {:op :unnest :column [:timestamp :open :high :low :close]} {:op :columns :keep [:symbol :timestamp :open :high :low :close] :rename {:timestamp :date}} {:op :type :column :date :to :date :from :unix} {:op :filter :column :close :test :not-blank}]))"},
  "B9>C5" {:src "\"Yahoo's chart, a request per share ({symbol} in the address, :each), made a table by steps: its lists of times and prices side by side, unnested together into a row per day.\""},
  "B9>A3" {:src "\"Worth\""},
  "B9>B3" {:name "worth", :render "(chart :line :date :value {:across {:dates true :title nil} :up {:title \"£\"}})",
           :src "(steps closes [{:op :join :table $>holdings>positions :on [[:symbol :symbol]] :columns [:shares]} {:op :compute :name \"value\" :expr #(* (:close %) (:shares %) $>prices>usd-gbp)} {:op :group :by [:date] :aggs [{:fn :sum :column :value :as :value}]} {:op :sort :by [[:date :asc]]}])"},

  ;; ---- settings
  "B10>A1" {:src "\"Settings\""},
  "B10>C1" {:src "\"Choose where prices come from, and give that service's key just below. [[$>A1|Home]]\""},
  "B10>A2" {:src "\"Prices from\""}, "B10>B2" {:name "provider", :src "\"Finnhub\"", :render "(dropdown)"},
  "B10>C2" {:src "\"Finnhub and Twelve Data each need a free key: sign up at finnhub.io or twelvedata.com, then paste it below. Their free plans price US shares. Yahoo needs no key, but a web page can't read it (Yahoo doesn't allow it), so it is read through a relay of your own.\""},
  "B10>A3" {:src "\"Finnhub key\""}, "B10>B3" {:src "\"finnhub\"", :render "key-input"},
  "B10>C3" {:src "\"Paste it and press Keep. It's kept in this browser only, never in the sheet or its file, and sent only to Finnhub. Until it's given, the prices shown are those recorded when the example was built, dimmed.\""},
  "B10>A4" {:src "\"Twelve Data key\""}, "B10>B4" {:src "\"twelvedata\"", :render "key-input"},
  "B10>C4" {:src "\"For the daily history on [[$>performance>A1|Performance]] (Finnhub's free plan has none), and for prices when Twelve Data is chosen.\""},
  "B10>A5" {:src "\"Relay\""}, "B10>B5" {:name "relay", :src "\"https://your-relay.example.workers.dev/\""},
  "B10>C5" {:src "\"For Yahoo: a relay's address, ending with /. Given what follows the /, it asks query1.finance.yahoo.com and answers with the header that lets a page read it. Help: Web requests has one to copy.\""},
  "B10>A6" {:src "\"Prices every\""}, "B10>B6" {:name "price-schedule", :src "\"*/15 9-16 * * 1-5\""},
  "B10>C6" {:src "\"When to ask for prices again: cron's minute, hour, day, month and weekday, read in the market's zone. Every quarter hour from 9:00 to 16:45, Monday to Friday.\""},
  "B10>A7" {:src "\"Market's zone\""}, "B10>B7" {:name "market-zone", :src "\"America/New_York\""},
  "B10>A8" {:src "\"Report in\""}, "B10>B8" {:name "report-in", :src "\"GBP\""},
;; ---- share: one share up close
  "B11>A1" {:src "\"A share\""},
  "B11>C1" {:src "\"Pick a share: its company, price, history and news follow. The company and news come from Finnhub (its key, in [[$>settings>A1|Settings]]); with Yahoo as the provider, the news comes from Yahoo. [[$>A1|Home]]\""},
  "B11>A2" {:src "\"Share\""}, "B11>B2" {:name "ticker", :src "\"AAPL\"", :render "(dropdown $>prices>symbols)"},
  "B11>A3" {:src "\"Company\""},
  "B11>B3" {:name "company", :render "(markdown \"![{name}|56]({logo})
### {name}
{finnhubIndustry} · {exchange} · [website]({weburl})
Market value **{marketCapitalization:$#,##0.0,} billion**\")",
            :src "(web \"https://finnhub.io/api/v1/stock/profile2\" {:query {:symbol ticker :token (secret \"finnhub\")} :fresh (every \"1d\")})"},
  "B11>C3" {:src "\"Finnhub's company profile, as Markdown: the logo an image, the website a link, the market value in bold.\""},
  "B11>A4" {:src "\"Price\""}, "B11>B4" {:name "share-price", :render "(kpi \"Last price\")", :src "(XLOOKUP ticker $>prices>quotes>symbol $>prices>quotes>price)"},
  "B11>A5" {:src "\"Today\""}, "B11>B5" {:render "(trend)", :src "(- (/ share-price (XLOOKUP ticker $>prices>quotes>symbol $>prices>quotes>previous)) 1)"},
  "B11>C5" {:src "\"Since the last close: trend draws it with an arrow, green up, red down.\""},
  "B11>A6" {:src "\"History\""},
  "B11>B6" {:render "(chart :stock :date [:open :high :low :close] {:days :trading})", :src "(steps $>performance>closes [{:op :filter :column :symbol :test := :value ticker}])"},
  "B11>C6" {:src "\"The daily prices of [[$>performance>A1|Performance]], this share's: a bar from open to close, a line from low to high.\""},
  "B11>A7" {:src "\"News\""},
  "B11>B7" {:name "news", :render "(markdown {:template \"#### [{headline}]({url})
