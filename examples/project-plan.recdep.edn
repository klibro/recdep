es of it.\"}\n   {:op :filter :column :days :test :> :value 0 :note \"Only the weeks with something booked.\"}\n   {:op :sort :by [[:week :asc] [:resource :asc]] :note \"By week, then by resource.\"}\n   {:op :columns :keep [:week :resource :days :capacity] :note \"What the chart reads.\"}])", :name "upcoming", :render "(chart :bar :week :days {:color :resource :stack :stacked :across {:dates true :title nil} :up {:title \"days booked\"}})"}, "B25>B5" {:src "(steps upcoming\n  [{:op :group :by [:week] :aggs [{:fn :max :column :capacity :as :days}] :note \"Each week's most working days: what a resource's days are measured against.\"}\n   {:op :compute :name :resource :expr (fn [_] \"Working days\") :note \"Named Working days.\"}\n   {:op :append :table (steps upcoming [{:op :sort :by [[:resource :asc]]}]) :note \"Then each resource's weeks.\"}\n   {:op :columns :keep [:resource :week :days] :note \"Resource, week and days booked.\"}\n   {:op :pivot :column :week :of :days :fn :sum :note \"The weeks across.\"}])", :render "(grid-view)"}, "B26" {:name "next-project"}, "B26>A1" {:src "\"Start\""}, "B26>A2" {:src "\"Tasks\""}, "B26>A3" {:src "\"Plan\""}, "B26>A4" {:src "\"If it came first\""}, "B26>B1" {:src "2027-02-15", :name "start", :format "d mmm yyyy"}, "B26>B2" {:name "help-tasks", :render "(grid-view)"}, "B26>B2>A1" {:src "\"ID\""}, "B26>B2>A2" {:src "\"1\""}, "B26>B2>A3" {:src "\"2\""}, "B26>B2>A4" {:src "\"3\""}, "B26>B2>B1" {:src "\"Task\""}, "B26>B2>B2" {:src "\"Help articles plan\""}, "B26>B2>B3" {:src "\"Help centre build\""}, "B26>B2>B4" {:src "\"Review\""}, "B26>B2>C1" {:src "\"Work\""}, "B26>B2>C2" {:src "3"}, "B26>B2>C3" {:src "4"}, "B26>B2>C4" {:src "1"}, "B26>B2>D1" {:src "\"Resource\""}, "B26>B2>D2" {:src "[\"Ana\"]"}, "B26>B2>D3" {:src "[\"Ben\"]"}, "B26>B2>D4" {:src "[\"Ana\" \"Ben\"]"}, "B26>B2>E1" {:src "\"After\""}, "B26>B2>E3" {:src "[\"1\"]"}, "B26>B2>E4" {:src "[\"2\"]"}, "B26>B3" {:src "(steps help-tasks\n  [{:op :compute :name :earliest :ex